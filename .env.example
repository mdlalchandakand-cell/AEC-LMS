# Public application settings only.
# Never place production secrets, database passwords, API tokens or payment keys in this file.
# Configure private values in the deployment environment or protected server-side config.

VITE_APP_NAME="Alom's English Center"
VITE_DEFAULT_LOCALE="bn"
VITE_DEFAULT_CURRENCY="BDT"

# Optional Laravel API bridge. Keep disabled until the Laravel API subdomain,
# HTTPS, CORS_ALLOWED_ORIGINS and SESSION_DOMAIN are configured on the server.
VITE_LARAVEL_API_ENABLED=false
# Example: https://api.example.com (no trailing slash); blank means same origin.
VITE_LARAVEL_API_BASE_URL=
